# Copy this file to .env (start.bat does it for you) and fill in your key.
# Get a key at https://console.anthropic.com. Without it the studio works, but the Claude buttons don't.
ANTHROPIC_API_KEY=

# Optional
PORT=8080
HOST=127.0.0.1
CLAUDE_MODEL_COMPLEX=claude-opus-5-5
CLAUDE_MODEL_DEFAULT=claude-sonnet-5-5
CLAUDE_MODEL_QUICK=claude-haiku-5-5
CLAUDE_MAX_TOKENS=16000

# For a public site: Claude buttons need this passphrase (leave empty on your own computer)
CLAUDE_PASSPHRASE=
# Most Claude requests per visitor per day (0 = no limit)
CLAUDE_DAILY_LIMIT=0
